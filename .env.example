# This file is written automatically by host-agent\install-agent.ps1  (with a real token).
# You normally do not need to edit it. docker compose reads it from the project root.

# URL of the host agent as seen from inside the portal container
AGENT_URL=http://host.docker.internal:8765

# Shared secret between portal and agent (install-agent.ps1 generates one)
AGENT_TOKEN=change-me

# Windows path of the data folder (mounted into the container as /data).
# Use your own project path, for example C:\path\to\android-device-portal\data
HOST_DATA_DIR=C:\path\to\android-device-portal\data
